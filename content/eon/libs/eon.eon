// The Eon compiler library
// EEE 2021
//
// TODO: Implement exports
// TODO: Add case statements
// TODO: statement blocks

#include "/libs/incl/sys.eon"

fn libInit() {
    _libload("/libs/string.ell");
    _libload("/libs/asm.ell");

    asm "ret";
}

// returns 1 if char is whitespace
fn isWhitespace(char) {
    if (@char == 32) return 1; // space
    if (@char == 10) return 1; // lf
    if (@char == 11) return 1; // tab
    if (@char == 13) return 1; // cr

    return 0;
}

// returns 1 if char should be a whole word
fn single(char) {
    if (@char == 59) return 1;  // ;
    if (@char == 123) return 1; // {
    if (@char == 125) return 1; // }
    if (@char == 40) return 1;  // (
    if (@char == 41) return 1;  // )
    if (@char == 44) return 1;  // ,
    if (@char == 64) return 1;  // @
    if (@char == 36) return 1;  // $

    return 0;
}

// sets the size of a string
fn setSize() {
    asm "size";
    asm "ret";
}

// gets the next word in a buffer
fn nextWord(buff, index) {
    var old_index = dup(index);
    var copy = dup(buff) + index;
    var length = 0;
    var done = 0;
    var ws = 0;
    var word = 1;
    var last_len = 0;
    var isQuote = 0;

    if (isWhitespace(copy)) {
        word = 0;
    }

    if (@copy == 34) { // "
        length += 1;
        index += 1;
        isQuote = 1;
    } else if (single(copy)) {
        index += 1;
        copy = setSize(copy, 1);

        return copy;
    }

    // find the next word
    while (done == 0) {
        copy += length - last_len;
        last_len = dup(length);
        if (copy == "") done = 1;

        if (@copy == 92) { // backslash
            // ignore next char backslash
            length += 2;
            index += 2;
        } else {
            ws = isWhitespace(copy);
            if (isQuote) {
                if (@copy == 34) { // "
                    if (length > 0) {
                        done = 1;
                        length += 1;
                        index += 1;
                    }
                }
            } else if (single(copy)) {
               if (length == 0) {
                   index += 1;
   
                   copy = setSize(dup(buff) + old_index, 1);

                   return copy;
               }

               done = 1;
            }

            if (isQuote) {
                ws = 0;
            }

            if (done == 0) {
                if (copy == "") done = 1;

                if ((ws == 1) && (word == 0)) {
                    index += 1;
                    old_index += 1;
                    copy += 1;
                } else if ((ws == 0) && (word == 0)) {
                    word = 1;
                    if (@copy == 34) {
                        isQuote = 1;
                    }
                } else if ((ws == 1) && (word == 1)) {
                    done = 1;
                    word = 0;
                }

                if (word) {
                    length += 1;
                    index += 1;
                }
            }
        }
    }
    
    copy = setSize(dup(buff) + old_index, length);
    
    var result = "";
    var ch = "";
    var tmp = "";
    for (0; copy != ""; copy += 1) {
        ch = @copy;
        result &= @ch;
        if (ch == 92) {
            result -= 1;
            copy += 1;
            if (@copy == 110) {
                result &= @92;
                result &= @110;
            } else if (@copy == 114) {
                result &= @92;
                result &= @114;
            } else if (@copy == 116) {
                result &= @92;
                result &= @116;
            } else {
                tmp = @copy;
                result &= @tmp;
            }
        }
    }

    return result;
}

// parses a block statment:
// if (expr) block
// while (expr) block
// for (expr; expr; expr) block
fn parseFlow(buff, index, stack, variable_table, is_library, heap_table) {
    var last_index = dup(index);
    var old_stack = dup(stack);
    var last_flow_index = numberToString(last_index);
    var tableCopy = dup(variable_table);
    var word = nextWord(buff, index);
    var result = "";
    var last = "";

    if (word == "if") {
        word = nextWord(buff, index);
        if (word == "(") {
            result &= parseExpression(buff, index, stack, variable_table, is_library, heap_table);
            word = nextWord(buff, index);
            if (word == ")") {
                if (stack != 255) stack -= 1;
                result &= "jz if_" & last_flow_index & "_else\n";

                result &= parseBlock(buff, index, stack, variable_table, 0, is_library, heap_table);

                stack = dup(old_stack);

                last = dup(index);

                word = nextWord(buff, index);
                if (word == "else") {
                    result &= "jmp if_" & last_flow_index & "_end\n";
                    result &= "if_" & last_flow_index & "_else:\n";
                    result &= parseBlock(buff, index, stack, variable_table, 0, is_library, heap_table);
                    result &= "if_" & last_flow_index & "_end:\n";

                    stack = old_stack;
                } else {
                    result &= "if_" & last_flow_index & "_else:\n";
                    index = last;
                }

                stack = old_stack;

                return result;
            }
        }
    }

    if (word == "while") {
        word = nextWord(buff, index);

        result = "while_" & last_flow_index & "_loop:\n";
        if (word != "(") error("for expected '('");

        result &= parseExpression(buff, index, stack, variable_table, is_library, heap_table);
        result &= "jz while_" & last_flow_index & "_end\n";
        if (stack != 255) stack -= 1;

        word = nextWord(buff, index);
        if (@word != ")") error("for expected ')' got " & word);

        result &= parseBlock(buff, index, stack, variable_table, 0, is_library, heap_table);

        result &= "jmp while_" & last_flow_index & "_loop\nwhile_" & last_flow_index & "_end:\n";

        stack = old_stack;

        return result;
    }

    if (word == "for") {
        word = nextWord(buff, index);
        if (word != "(") error("for expected '('");

        result = parseStmt(buff, index, stack, variable_table, is_library, heap_table);

        result &= "for_" & last_flow_index & "_loop:\n";

        result &= parseExpression(buff, index, stack, variable_table, is_library, heap_table);

        word = nextWord(buff, index);
        if (@word != 59) error("for expected 'sc2' got " & word);

        result &= "jz for_" & last_flow_index & "_end\n";

        if (stack != 255) stack -= 1;

        last = parseExpression(buff, index, stack, variable_table, is_library, heap_table);

        if (stack != 255) stack -= 1;

        word = nextWord(buff, index);
        if (word != ")") error("for expected ')'");

        result &= parseBlock(buff, index, stack, variable_table, 0, is_library, heap_table);

        result &= last & "disc 0\njmp for_" & last_flow_index & "_loop\nfor_" & last_flow_index & "_end:\n";

        if (stack != 255) {
            for (0; stack > old_stack; stack = stack - 1) {
                result &= "disc 0\n";
            }
        }

        stack = old_stack;
        variable_table = tableCopy;

        return result;
    }

    index = last_index;

    return "";
}

// parses a var statment:
// var name [ = value ]
fn parseVar(buff, index, stack, variable_table, is_library, heap_table) {
    var last_index = dup(index);
    var word = nextWord(buff, index);
    var next = "";
    var old_index;

    if (word == "var") {
        word = nextWord(buff, index);

        if (stack != 255) stack += 1;

        while (_StringLength(word) < 20) {
            word = word & @0;
        }

        _TablePut(variable_table, word, @stack);

        old_index = dup(index);

        next = nextWord(buff, index);

        if (next == "=") {
           if (stack != 255) stack -= 1;

            return parseExpression(buff, index, stack, variable_table, is_library, heap_table);
        }

        index = old_index;

        return "push 0\n";
    }

    index = last_index;

    return "";
}

// parses a builtin expression:
// return expr
// asm "expr"
fn parseBuiltin(buff, index, stack, variable_table, is_library, heap_table) {
    var last_index = dup(index);
    var word = nextWord(buff, index);
    var result = "";

    if (word == "return") {
        result = parseExpression(buff, index, stack, variable_table, is_library, heap_table);

        for (0; stack > 1; stack -= 1) {
            result &= "disc 1\n";
        }

        stack = 255;

        return result & "ret\n";
    }

    if (word == "asm") {
        word = nextWord(buff, index);

        return ((word + 1) - 1) & "\n";
    }


    index = last_index;

    return "";
}

fn parseFactor(buff, index, stack, variable_table, is_library, heap_table) {
    var last_index = dup(index);
    var word = nextWord(buff, index);
    var result = "";

    if (word == "return") {
        index = last_index;

        return "";
    }

    if (word == "(") {
        result = parseExpression(buff, index, stack, variable_table, is_library, heap_table);

        word = nextWord(buff, index);

        if (word == ")") {
            return result;
        }
    }
    
    if (word == "$") {
       result = parseFactor(buff, index, stack, variable_table, is_library, heap_table);

       return result & "sys 15\n";
    }

    if (word == "@") {
       result = parseFactor(buff, index, stack, variable_table, is_library, heap_table);

       return result & "getb\n";
    }

    if (_StringIsNum(word)) {
        if (stack != 255) stack = stack + 1;
        return "push " & word & "\n";
    }

    if ((@word == 34) && (_StringEndsWith(word, @34))) {
        if (stack != 255) stack = stack + 1;
        return "push " & word & "\n";
    }

    var newWord = dup(word);

    while (_StringLength(newWord) < 20) {
        newWord = newWord & @0;
    }

    var variable = _TableGet(variable_table, newWord);
    var index = 0;

    if (variable != "") {
        index = stack - @variable;
        index = numberToString(index);

        if (stack != 255) stack = stack + 1;

        return "copy " & index & "\n";
    }
    
    variable = _TableGet(heap_table, newWord);

    if (variable != "") {
        index = numberToString(@variable);

        if (stack != 255) stack = stack + 1;

        return "push " & index & "\n";
    }

    var next = nextWord(buff, index);
    var old_stack = dup(stack);
    var tmp = @34;

    if (next == "(") {
        result = parseCall(buff, index, stack, variable_table, is_library, heap_table);
        next = nextWord(buff, index);

        if (next == ")") {
            if (word == "dup") {
                return result & "dup 0\ndisc 1\n";
            } else if (@word == 95) {
                word = word + 1;
                word = tmp & word & tmp;
            } else if (is_library) {
                word = tmp & word & tmp;
            }

            if (old_stack != 255) stack = old_stack + 1;

            return result & "call " & word & "\n";
        }
    }

    index = last_index;

    return "";
}

fn parseTerm(buff, index, stack, variable_table, is_library, heap_table) {
    var term = "";
    var word = "";
    var done = 0;

    var last_index;

    var result = parseFactor(buff, index, stack, variable_table, is_library, heap_table);

    while (done == 0) {
        last_index = dup(index);

        word = nextWord(buff, index);

        if (word == "*") {
            term = parseFactor(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "mul\n";
            if (stack != 255) stack -= 1;
        } else if (word == "/") {
            term = parseFactor(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "div\n";
            if (stack != 255) stack -= 1;
        } else if (word == "%") {
            term = parseFactor(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "mod\n";
            if (stack != 255) stack -= 1;
        } else {
            done = 1;
            index = last_index;
        }
    }

    return result;
}

fn parseSum(buff, index, stack, variable_table, is_library, heap_table) {
    var term = "";
    var word = "";
    var done = 0;

    var last_index;

    var result = parseTerm(buff, index, stack, variable_table, is_library, heap_table);

    while (done == 0) {
        last_index = dup(index);

        word = nextWord(buff, index);

        if (word == "-") {
            term = parseTerm(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "sub\n";
            if (stack != 255) stack -= 1;
        } else if (word == "+") {
            term = parseTerm(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "add\n";
            if (stack != 255) stack -= 1;
        } else if (word == "&") {
            term = parseTerm(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "cat\n";
            if (stack != 255) stack -= 1;
        } else {
            done = 1;
            index = last_index;
        }
    }

    return result;
}

fn parseExpression(buff, index, stack, variable_table, is_library, heap_table) {
    var term = "";
    var word = "";
    var done = 0;

    var last_index;

    var result = parseSum(buff, index, stack, variable_table, is_library, heap_table);

    while (done == 0) {
        last_index = dup(index);

        word = nextWord(buff, index);

        if (word == "==") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "eq\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == ":=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "sys 16\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == "<") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "lt\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == ">") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "gt\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == "=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "set\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == "+=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "copy 1\n"; // a b a
            result &= "copy 1\n"; // a b a b
            result &= "add\n";    // a b a+b
            result &= "disc 1\n"; // a a+b
            result &= "set\n";    // a
            if (stack != 255) stack = stack - 1;
        } else if (word == "&=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term; // b a
            result &= "copy 1\n"; // a b a
            result &= "copy 1\n"; // a b a b
            result &= "cat\n";    // a b a&b
            result &= "disc 1\n"; // a a&b
            result &= "set\n";    // a 
            if (stack != 255) stack = stack - 1;
        } else if (word == "-=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "copy 1\n"; // a b a
            result &= "copy 1\n"; // a b a b
            result &= "sub\n";    // a b a-b
            result &= "disc 1\n"; // a a-b
            result &= "set\n";    // a
            if (stack != 255) stack = stack - 1;
        } else if (word == "!=") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "eq\nnot\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == "&&") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "and\n";
            if (stack != 255) stack = stack - 1;
        } else if (word == "||") {
            term = parseSum(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
            result &= "or\n";
            if (stack != 255) stack = stack - 1;
        } else {
            done = 1;
            index = last_index;
        }
    }

    return result;
}

fn parseCall(buff, index, stack, variable_table, is_library, heap_table) {
    var term = "";
    var word = "";
    var done = 0;

    var last_index;

    var result = parseExpression(buff, index, stack, variable_table, is_library, heap_table);

    while (done == 0) {
        last_index = dup(index);

        word = nextWord(buff, index);

        if (word == ",") {
            term = parseExpression(buff, index, stack, variable_table, is_library, heap_table);
            result &= term;
        } else {
            done = 1;
            index = last_index;
        }
    }

    return result;
}

fn verifyStmtStack(stack, start) {
    if (stack == 255) return "";

    if (stack + 1 == start) {
        if (stack != 255) stack = stack - 1;
        return "disc 0\n";
    }

    return "";
}

fn parseStmt(buff, index, stack, variable_table, is_library, heap_table) {
    var last_index;
    var parsed = "";
    var next = "";
    var old_stack = dup(stack);

    last_index = dup(index);

    parsed = parseExpression(buff, index, stack, variable_table, is_library, heap_table);

    if (parsed != "") {
        next = nextWord(buff, index);

        if (@next == 59) {
           parsed = parsed & verifyStmtStack(stack, old_stack);
           return parsed;
        }
    }

    index = dup(last_index);
    stack = dup(old_stack);

    parsed = parseBuiltin(buff, index, stack, variable_table, is_library, heap_table);

    if (parsed != "") {
        next = nextWord(buff, index);

        if (@next == 59) {
           parsed = parsed & verifyStmtStack(stack, old_stack);
           return parsed;
        }
    }

    index = dup(last_index);
    stack = dup(old_stack);

    parsed = parseVar(buff, index, stack, variable_table, is_library, heap_table);

    if (parsed != "") {
        next = nextWord(buff, index);

        if (@next == 59) {
           return parsed;
        }
    }

    index = dup(last_index);
    stack = dup(old_stack);

    parsed = parseFlow(buff, index, stack, variable_table, is_library, heap_table);

    if (parsed != "") {
        return parsed;
    }

    index = last_index;
    stack = old_stack;

    return "";
}

fn parseBlock(buff, index, stack, variable_table, function, is_library, heap_table) {
    var old = dup(index);
    var word = nextWord(buff, index);
    var old_stack = dup(stack);
    var code = "";
    var done = 0;
    var statement_data;
    var last_index;
    var stackCopy;

    var tableCopy = dup(variable_table);

    if (word != "{") {
        index = dup(old);

        var result = parseStmt(buff, index, stack, variable_table, is_library, heap_table);

        if ((stack != 255) && (function == 0)) {
            for (0; stack > old_stack; stack = stack - 1) {
                result &= "disc 0\n";
            }
        }

        stack = old_stack;

        variable_table = dup(tableCopy);

        return result;
    }

    while (done == 0) {
        last_index = dup(index);
        word = nextWord(buff, index);
        stackCopy = dup(stack);

        if (word != "}") {
            if (stack == 255) {
                error("Code after return");
            }

            if (word == "") error("Early EOF Encountered");

            index = dup(last_index);
            statement_data = parseStmt(buff, index, stack, variable_table, is_library, heap_table);

            if (statement_data == "") {
                done = 1;
            }

            code = code & statement_data;
        } else {
            done = 1;
        }
    }

    variable_table = tableCopy;

    if ((stack != 255) && (function == 0)) {
        for (0; stack > old_stack; stack = stack - 1) {
            code = code & "disc 0\n";
        }
    }

    stack = old_stack;

    return code;
}

fn parseFunction(buff, index, is_library, heap_table) {
    var word;
    
    word = nextWord(buff, index);

    if (word != "fn") error("Expected 'fn' got '" & word & "'");
    var name = nextWord(buff, index);

    if (is_library) name = "_" & name;

    word = nextWord(buff, index);
    if (word != "(") error("Expected '(' got '" & word & "'");

    var done = 0;
    var stack = 0;
    var variable_table = _TableCreate(20, 1);

    while (done == 0) {
        word = nextWord(buff, index);

        if (word != ")") {
            while (_StringLength(word) < 20) {
                word = word & @0;
            }

            if (stack != 255) stack = stack + 1;

            _TablePut(variable_table, word, @stack);

            word = nextWord(buff, index);

            if (word == ")") {
                done = 1;
            }
        } else {
            done = 1;
        }
    }

    if (word != ")") error("Expected ')' got '" & word & "'");

    var block = parseBlock(buff, index, stack, variable_table, 1, is_library, heap_table);

    if (block == "") return "";

    return name & ":\n" & block;
}

fn parseFile(buff, index, is_library) {
    var code = "";
    if (is_library == 0) code &= "call main\nsys 1\n";
    var func = "";
    var word = "";
    var done = 0;
    var last_index = 0;
    var heap_index = 0;
    var heap_table = _TableCreate(20, 1);

    while (done == 0) {
        last_index = dup(index);
        word = nextWord(buff, index);

        if (word == "fn") {
            index = dup(last_index);
    
            func = parseFunction(buff, index, is_library, heap_table);

            code = code & func;
        } else if (word == "var") {
            word = nextWord(buff, index);
            while (_StringLength(word) < 20) {
                word = word & @0;
            }
            _TablePut(heap_table, word, @heap_index);
            heap_index += 1;
            word = nextWord(buff, index);
            if (word != @59) {
                error("Expected semicolon");
            }
        } else if (word == "") {
            done = 1;
        } else {
            error("Invalid word Encountered: '" & word & "'");
        }
    }

    return "push " & numberToString(_TableLen(heap_table)) & "\nsys 14\n" & code;
}

fn split(conts, delim) {
    var done = 0;
    var start = dup(conts);
    var index = 0;
    var chars;
    var delimSize = _StringLength(delim);

    while (done == 0) {
        chars = dup(conts);
        chars = setSize(chars, delimSize);

        if (chars == delim) {
            start = setSize(start, index);
            conts = conts + 1;

            return start;
        }

        if (conts == "") {
            done = 1;
        }

        conts = conts + 1;
        index = index + 1;
    }

    return start;
}

fn remcomment(line) {
   return split(line, @47 & @47);
}

fn preprocess(name, conts) {
    print("EON: '" & name & "'\n");

    var nl = "\n";
    var result = "";
    var newName;
    var file;
    var buff;

    for (var line = split(conts, nl); (conts != "") || (line != ""); line = split(conts, nl)) {
        if (_StringStartsWith(line, "#include")) {
            newName = line + 10;
            newName = newName - 1;

            file = open(newName);
            buff = read(file, fileSize(newName));
            close(file);

            result &= preprocess(newName, buff) & "\n";
        } else {
            result &= remcomment(line) & "\n";
        }
    }

    return result;
}

fn eonFile(path, output_name, is_library) {
    var asmName = path & ".asm";
    var index = 0;

    var fileConts = readAll(path);
    var finalConts = preprocess(path, fileConts);

    var asmTmp = createOpen(asmName);
    write(asmTmp, parseFile(finalConts, index, is_library));
    close(asmTmp);

    _asmFile(asmName, output_name, is_library);

    return 0;
}

// --- EEE Sees all ---