#include "/libs/incl/libload.eon"
#include "/libs/incl/sys.eon"

fn createMap() {
    // tileSize, width, height
    var result = "";
    var x;
    var y;

    var size = 1 * 8 * 24;
    result = result & new size;

    return result;
}

fn getTile(map, pos) {
    var tile = map + pos;
    var tile_value = @tile;
    var id = tile_value + 65;

    var x = tile_value / 4;
    var y = tile_value % 4;

    return _MakeRect(256 * x, 256 * y, 256, 256);
}

fn renderMap(map, win, tex) {
    var x;
    var y;
    var position = 0;
    var id = "";
    var source = _MakeRect(256, 0, 256, 256);
    var dest = _MakeRect(0, 0, 16, 16);
    
    _WindowClear(win);

    for (y = 0; y < 24; y = y + 1) {
        for (x = 0; x < 8; x = x + 1) {
            position = y * 8;
            position += x;
            id = map + position;
            id = @id;
            id = id % 16;

            if (id) {
                source = getTile(map, position);
                dest = _MakeRect(x * 16, y * 16, 16, 16);

                _WindowRender(win, tex, dest, source);
            }
        }
    }

    _WindowText(win, 140, 10, "score:");
    _WindowText(win, 140, 30, "000000");

    return 0;
}

fn spawnTiles(map) {
    var i = random(4);

    var result = map;

    return result;
}

fn updateMap(map) {
    var x = 0;
    var y = 1;
    var result = "";
    var position = 0;
    var position_up = 0;
    var position_down = 0;
    var tile = 0;
    var tile_up = 0;
    var tile_down = 0;
    var tile_value = "";
    var tile_up_value = "";
    var tile_down_value = "";

    for (x = 0; x < 8; x = x + 1) {
        result = result & @0;
    }

    var control = 0;

    for (y = 0; y < 23; y = y + 1) {
        for (x = 0; x < 8; x = x + 1) {
            position_up = y * 8;
            position_up = position_up + x;

            position = position_up + 8;
            position_down = position + 8;

            tile_value = map + pos;
            tile = @tile_value;
            if (tile > 15) {
                control = 1;
            }

            tile_up_value = map + position_up;
            tile_up = @tile_up_value;
            if (tile_up > 15) {
                control = 1;
            }

            tile_down_value = map + position_down;
            tile_down = @tile_down_value;
            tile_down = tile_down % 16;

            if (y == 22) {
                tile_down = 15;
            }

            if (tile == 0) {
                if (tile_up != 0) {
                    result = result & @tile_up;
                } else {
                    result = result & @0;
                }
            } else {
                if (tile_down == 0) {
                    result = result & @0;
                } else {
                    tile = tile % 16;
                    result = result & @tile;
                }
            }
        }
    }

    if (control == 0) {
        return spawnTiles(result);
    }

    return result;
}

fn update(map, counter, dt) {
    counter = counter + dt;

    if (counter > 100) {
        counter = counter - 100;
        map = updateMap(map);
    }

    return 0;
}

fn main() {
    setupLibLoad();
    loadLib("/libs/window.ell");
    loadLib("/libs/texture.ell");
    loadLib("/libs/string.ell");

    var map = createMap();
    var window = _WindowCreate();
    var texture = _TextureCreate();
    var last_time = time();
    var counter = 0;
    var dt = 0;

    _SetWindowRule("min", 256 + 6, 384 + 38);
    _SetWindowRule("max", 256 + 6, 384 + 38);
    _SetWindowTitle(window, "Connectris");
    _SetWindowSize(256 + 6, 384 + 38);

    var test = "";

    _TextureUpload(_TextureRead("/cont/imgs/connectris.eia"), texture);

    for (0; _WindowOpen(); 1) {
        dt = time() - last_time;
        last_time = time();

        update(map, counter, dt);
        
        renderMap(map, window, texture);
        
        _WindowFlip(window);
    }

    _TextureDestroy(texture);
    _WindowDestroy(window);

    asm "ret";
}

