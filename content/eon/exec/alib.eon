#include "/libs/incl/libload.eon"

fn processArgs() {
    var file = 1;
    asm "sys 8";

    if (file == "") {
        asm "push \"Bad Argument\"";
        asm "sys 18";
    }

    return file;
}

fn main() {
    // load libs
    setupLibLoad();
    loadLib("/libs/asm.ell");

    var output_file = 2;
    asm "sys 8";

    if (output_file == "") {
        output_file = "out.eep";
    }

    // open input
    var input_file = processArgs();

    _asmFile(input_file, output_file, 1);

    return 0;
}
