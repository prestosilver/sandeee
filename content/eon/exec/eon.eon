#include "/libs/incl/libload.eon"
#include "/libs/incl/sys.eon"

fn main() {
    setupLibLoad();
    loadLib("/libs/eon.ell");

    var file_name = getArgument(1);
    var output_name = "out.eep";

    if (getArgument(2) != "") {
        output_name = getArgument(2);
    }

    _eonFile(file_name, output_name, 0);
    
    return 0;
}
