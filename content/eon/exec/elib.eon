#include "/libs/incl/libload.eon"
#include "/libs/incl/sys.eon"

fn main() {
    setupLibLoad();
    loadLib("/libs/eon.ell");

    var file_name = getArg(1);
    var output_name = "out.ell";

    if (getArg(2) != "") {
        output_name = getArg(2);
    }

    _eonFile(file_name, output_name, 1);
    
    return 0;
}
