#include <winver.h>

IDI_ICON1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 means US English, Unicode charset
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "prestosilver\0"
            VALUE "FileDescription",  "The SandEEE VM\0"
            VALUE "FileVersion",      "{f}\0"
            VALUE "InternalName",     "SandEEE\0"
            VALUE "LegalCopyright",   "\0"
            VALUE "OriginalFilename", "SandEEE.exe\0"
            VALUE "ProductName",      "SandEEE\0"
            VALUE "ProductVersion",   "{f}\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END 
END