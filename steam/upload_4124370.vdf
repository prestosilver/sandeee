"AppBuild"
{
	"AppID" "4124370" // your AppID

	"BuildOutput" "./SteamLog" // build output folder for build logs and build cache files
    "SetLive" "alpha" // set this build live on a beta branch

	"Depots"
	{
		"4124371" // Content depot
		{
			"FileMapping"
			{
				"LocalPath" "./content_demo/*" // all files from contentroot folder
				"DepotPath" "./content_demo" // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
		}
	}

	// END TEMPLATE
    "Desc" "Auto Upload"
	"ContentRoot" "../zig-out/pub/steam/" // root content folder, relative to location of this file
}
