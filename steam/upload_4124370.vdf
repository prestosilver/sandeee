"AppBuild"
{
	"AppID" "4124370" // Demo id

	"BuildOutput" "./UploadDemoLog"
    "SetLive" "alpha"

	"Depots"
	{
		"4124371" // Content depot
		{
			"FileMapping"
			{
				"LocalPath" "./content_demo/*"
				"DepotPath" "./content_demo"
				"recursive" "1"
			}
		}
	}

	// END TEMPLATE
	"ContentRoot" "../zig-out/pub/steam/"
    "Desc" "Auto Upload"
}
