"AppBuild"
{
	"AppID" "4124360" // Base game id
	
	"BuildOutput" "./UploadGameLog"
    "SetLive" "alpha"

	"Depots"
	{
		"4124362" // Content depot
		{
			"FileMapping"
			{
				"LocalPath" "./content/*"
				"DepotPath" "./content"
				"recursive" "1"
			}
		}
		"4124363" // Linux depot
		{
			"FileMapping"
			{
				"LocalPath" "./linux/*"
				"DepotPath" "./"
				"recursive" "1"
			}
		}
		"4124364" // Windows depot
		{
			"FileMapping"
			{
				"LocalPath" "./windows/*"
				"DepotPath" "./"
				"recursive" "1"
			}
		}
	}
	
	// END TEMPLATE
	"ContentRoot" "../zig-out/pub/steam/"
    "Desc" "Auto Upload"
}
